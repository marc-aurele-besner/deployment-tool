{
  "name": "deployment-tool",
  "version": "0.1.7",
  "description": "Tool to deploy and upgrade contracts on Ethereum Mainnet",
  "repository": "https://github.com/marc-aurele-besner/deployment-tool.git",
  "author": "Marc-Aurele Besner <82244926+marc-aurele-besner@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "bin": {
    "deployment-tool": "./dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/marc-aurele-besner/deployment-tool/issues"
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "format": "prettier --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\" && prettier --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "prepublishOnly": "tsc --project tsconfig.prod.json",
    "build": "tsc --project tsconfig.prod.json",
    "watch": "tsc -w",
    "test": "hardhat test",
    "compile": "hardhat build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-keystore": "^3.0.0",
    "@nomicfoundation/hardhat-mocha": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.21",
    "@nomicfoundation/ignition-core": "^3.0.0",
    "@openzeppelin/hardhat-upgrades": "^4.1.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "awesome-readme": "^1.0.0",
    "chai": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.0.0",
    "hardhat": "^3.11.1",
    "hardhat-awesome-cli": "^0.7.2",
    "mocha": "^11.0.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.64.0"
  },
  "peerDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.10",
    "@openzeppelin/hardhat-upgrades": "^4.0.0",
    "hardhat": "^3.0.0",
    "hardhat-awesome-cli": "^0.7.2"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "fs": "^0.0.1-security",
    "inquirer": "^14.0.2"
  }
}
